# Required for the Google Maps embeds used on:
#   /cost         (regional spend heatmap)
#   /fvm/deployments (fleet deployment tracker)
#   /vrds/*       (dispatch map + route planning)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Main Supabase project used by alerts, costs, and tracking reads.
NEXT_PUBLIC__FTM_SUPABASE_URL=
NEXT_PUBLIC_FTM_SUPABASE_ANON_KEY=

# Public app URL used in Supabase email verification redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js serves the FTM API on this app's origin. Do not configure an external API base URL.

# Server-only Supabase keys used by Next.js Route Handlers
FTM_SUPABASE_URL=
FTM_SUPABASE_ANON_KEY=
FTM_SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only separate parcel database
FTM_PARCELS_SUPABASE_URL=
FTM_PARCELS_SUPABASE_SERVICE_ROLE_KEY=
FTM_PARCELS_SUPABASE_ANON_KEY=

# Optional separate HR database bridge
HR_SUPABASE_URL=
HR_SUPABASE_SERVICE_ROLE_KEY=

# Optional CORS allowlist; comma-separated origins are supported
CORS_ORIGIN=*

# OTP hashing and delivery
FTM_OTP_HASH_SECRET=
FTM_RESEND_API_KEY=
FTM_RESEND_FROM=
FTM_SMTP_HOST=
FTM_SMTP_PORT=587
FTM_SMTP_SECURE=false
FTM_SMTP_USER=
FTM_SMTP_PASS=
FTM_SMTP_FROM=

# Server-only deployed OR-Tools service endpoint (set in Vercel Production env)
ORTOOLS_SERVICE_URL=https://airship-ftm-ortoolss.onrender.com/optimize
OPTIMIZER_API_KEY=
ANTHROPIC_API_KEY=
FLEET_AI_MODEL=claude-sonnet-4-6

# Optional receipt OCR providers; the OCR route uses any configured provider
GOOGLE_CLOUD_VISION_API_KEY=
AZURE_COMPUTER_VISION_KEY=
AZURE_COMPUTER_VISION_ENDPOINT=
OCR_SPACE_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
OCR_TIMEOUT_MS=6000

# Optional separate Supabase project used by parcel reads.
NEXT_PUBLIC_FTM_PARCEL_SUPABASE_URL=
NEXT_PUBLIC_FTM_PARCEL_SUPABASE_ANON_KEY=

# Keep all service-role keys and provider secrets server-only; never prefix them with NEXT_PUBLIC_.
